function throwBall(){const r=playArea.getBoundingClientRect(),ballW=gameBall.offsetWidth||48,petW=gamePet.offsetWidth||92,pad=10;if(r.width<ballW+pad*2||r.height<120)return toast('The playground is too small for ball play.');const targetX=Math.max(pad,Math.min(r.width-ballW-pad,r.width*.68)),targetBottom=Math.max(pad,Math.min(r.height-ballW-pad,r.height*.42));ballThrows++;gameBall.classList.add('flying');gameBall.style.left=targetX+'px';gameBall.style.bottom=targetBottom+'px';gameBall.style.transform=`rotate(${ballThrows*420}deg)`;gamePet.style.left=Math.min(78,Math.max(50,targetX/r.width*100))+'%';gamePet.classList.add('catch');playSound('tap');haptic(25);setTimeout(()=>{const catchX=Math.max(pad,Math.min(r.width-ballW-pad,targetX+Math.max(0,(petW-ballW)/3)));gameBall.style.left=catchX+'px';gameBall.style.bottom=Math.max(pad,targetBottom-ballW*.8)+'px';joyPop('✨',catchX,targetBottom);playScore.textContent=`Catches ${Math.min(ballThrows,3)} / 3`;if(ballThrows>=3)completePlayReward('Amazing! Your pet caught the ball three times!');else setTimeout(()=>{gamePet.style.left='50%';gamePet.classList.remove('catch');resetBall()},650)},650)}
function completePlayReward(message){playInstruction.textContent=message;const p=activePet();if(playRewardReady){playRewardReady=false;p.lastPlay=Date.now();p.lastCareAt=Date.now();p.lastDecayAt=Date.now();p.happiness=clamp(p.happiness+8);p.friendXP+=5;levelPet(p);save();render();playSound('coin');setTimeout(()=>toast('Happiness +8 • Friendship +5'),300)}else toast('Play reward is recharging, but the game remains open for fun.')}
function closePlay(){playModal.classList.remove('show');gamePet.style.left='50%';resetBall()}
gamePet.addEventListener('pointerdown',patPet);gameBall.addEventListener('pointerdown',ballDown);gameBall.addEventListener('pointermove',ballMove);gameBall.addEventListener('pointerup',ballUp);gameBall.addEventListener('pointercancel',ballUp);
function levelPet(p){while(p.friendXP>=p.level*100){p.friendXP-=p.level*100;p.level++;state.player.stars+=1}}
const EX={breathing:[['Calm Balloon',300],['Rainbow Breathing',600],['Breeze Master',900]],meditation:[['Kindness Garden',300],['Moonlight Calm',600],['Peaceful Explorer',900]]};
function openPractice(type){
 chooseTitle.textContent=type==='breathing'?'Choose a breathing adventure':'Choose a meditation adventure';
 chooseIntro.textContent=type==='breathing'?'Your pet will follow the calm circle with you. Breathe comfortably, never force the breath.':'Your pet will sit quietly beside you. No special breathing pattern is needed.';
 practiceOptions.replaceChildren();EX[type].forEach(([name,sec])=>{const reward=sec>=900?'✨ Super Calm Treasure':sec>=600?'🎁 Calm Treasure':'🌱 Habit Builder',button=document.createElement('button');button.className=`btn ${type==='breathing'?'blue':'green'}`;button.innerHTML=`<span>${name} • ${sec/60} min<br><small style="opacity:.9">${reward}</small></span>`;button.addEventListener('click',()=>startPractice(type,name,sec));practiceOptions.append(button)});chooseModal.classList.add('show')
}
function startPractice(type,name,seconds){playSound('tap');closeModal('chooseModal');completionLocked=false;session={id:(crypto.randomUUID?.()||String(Date.now())),type,name,planned:seconds,remaining:seconds,running:true,last:Date.now(),endAt:Date.now()+seconds*1000,breathPhase:'inhale',hiddenPauses:0,attentionPassed:0,attentionMissed:0,attentionDue:false,visibleSeconds:0,pausedSeconds:0};practiceTitle.textContent=name;practiceGuide.textContent=type==='breathing'?'Follow the expanding circle gently. Return to normal breathing if uncomfortable.':'Sit or lie comfortably. Notice sounds, body sensations, or the quiet around you. No special breathing pattern is required.';orb.className=type==='meditation'?'orb meditation':'orb';orb.textContent=type==='meditation'?'Be still':'Get ready';prepareBuddy(type);pauseBtn.textContent='⏸ Pause';showView('practice');timerLoop();if(type==='breathing')breathLoop();scheduleAttention()}
function timerLoop(){clearInterval(tick);tick=setInterval(()=>{if(!session)return;const now=Date.now();if(session.running&&!document.hidden){session.remaining=Math.max(0,Math.ceil((session.endAt-now)/1000));session.visibleSeconds=Math.min(session.planned,session.planned-session.remaining)}else session.pausedSeconds+=.25;UI.timer.textContent=format(session.remaining);if(session.remaining>0&&session.remaining%60===0&&session.lastAnnounced!==session.remaining){session.lastAnnounced=session.remaining;UI.a11y.textContent=`${session.remaining/60} minutes remaining`}updateParticipation();if(session.remaining<=0)completePractice()},250)}
function stopBreathLoop(){clearTimeout(breathPhaseTimer);cancelAnimationFrame(breathRAF);breathPhaseTimer=null;breathRAF=null}
function breathLoop(phase=session?.breathPhase||'inhale'){
 stopBreathLoop();if(!session||session.type!=='breathing'||!session.running)return;session.breathPhase=phase;const duration=phase==='inhale'?4000:5000;orb.className='orb '+phase;orb.textContent=phase==='inhale'?'Breathe in':'Breathe out';
 if(state.settings.reducedMotion){orb.className='orb';const started=performance.now();const frame=now=>{if(!session||!session.running)return;const pct=Math.min(1,(now-started)/duration);orb.style.background=`conic-gradient(${phase==='inhale'?'#2f9cf4':'#22b884'} ${pct*360}deg,#ddebfa 0)`;if(pct<1)breathRAF=requestAnimationFrame(frame)};breathRAF=requestAnimationFrame(frame)}
 breathPhaseTimer=setTimeout(()=>breathLoop(phase==='inhale'?'exhale':'inhale'),duration)
}
function scheduleAttention(){
 clearTimeout(attentionTick);if(!session||session.remaining<75||session.attentionDue)return;const token=session.id;
 const wait=Math.min(150000,Math.max(65000,(session.remaining-40)*500));
 attentionTick=setTimeout(()=>{if(session&&session.id===token&&!session.attentionDue)showPresenceCheck()},wait+Math.random()*30000)
}
function showPresenceCheck(){
 if(!session||!session.running||session.attentionDue)return;clearTimeout(attentionTick);session.running=false;session.attentionDue=true;playSound('attention');
 const symbols=['⭐','🌿','☁️','🌙'],answer=symbols[Math.floor(Math.random()*symbols.length)];session.presenceAnswer=answer;
 buddyMessage('A tiny check, then we will continue together.');presencePrompt.textContent=session.type==='breathing'?'Breathing buddy check':'Mindful listening check';
 presenceInstruction.textContent=session.type==='breathing'?`Tap ${answer} and take one comfortable breath.`:`Tap ${answer} after noticing one sound around you.`;
 presenceChoices.innerHTML=shuffle([...symbols]).map(x=>`<button class="btn soft" onclick="answerPresence('${x}')">${x}</button>`).join('');presenceCard.classList.add('show');pauseBtn.textContent='▶ Resume after check';
 session.checkDeadline=setTimeout(()=>{if(session&&session.attentionDue){session.attentionMissed++;presenceInstruction.textContent='The check was missed. Choose the correct symbol when ready.';updateParticipation()}},20000)
}
function answerPresence(x){if(!session||!session.attentionDue||!session.presenceAnswer)return;if(x!==session.presenceAnswer){playSound('attention');toast('Look again for the matching symbol.');return}clearTimeout(session.checkDeadline);session.attentionPassed++;session.attentionDue=false;session.presenceAnswer=null;presenceCard.classList.remove('show');setSessionRunning(true,'Check complete. Practice resumed.');buddyMessage(session.type==='meditation'?'Back to quiet time together.':'Let us follow the circle again.');scheduleAttention();updateParticipation()}
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function updateParticipation(){if(!session)return;const expected=Math.max(1,session.planned-session.remaining),visible=Math.min(100,Math.round(session.visibleSeconds/expected*100)),penalty=session.hiddenPauses*12+session.attentionMissed*18,score=Math.max(0,Math.min(100,visible-penalty));participationFill.style.width=score+'%';UI.participationBar.setAttribute('aria-valuenow',score);participationText.textContent=`${score}% presence • ${session.attentionPassed} checks completed • ${session.hiddenPauses} app exits`;session.presenceScore=score}
function setSessionRunning(shouldRun,message=''){
 if(!session||session.running===shouldRun)return;const now=Date.now();if(shouldRun){session.endAt=now+session.remaining*1000;session.running=true;session.last=now;pauseBtn.textContent='⏸ Pause';if(session.type==='meditation'){orb.className='orb meditation';orb.textContent='Be still'}else breathLoop(session.breathPhase||'inhale');UI.a11y.textContent='Practice resumed'}else{session.remaining=Math.max(0,Math.ceil((session.endAt-now)/1000));session.running=false;session.last=now;stopBreathLoop();pauseBtn.textContent='▶ Resume';orb.textContent='Paused';UI.a11y.textContent='Practice paused'}if(message)toast(message)
}
function pauseResume(){if(!session)return;if(session.attentionDue)return toast('Complete the mindful check first.');setSessionRunning(!session.running,session.running?'Practice paused. Tap Resume when ready.':'Practice resumed.');}

function quitPractice(){cleanup();showView('home');toast('Practice ended. No penalty.')}
function cleanup(){clearInterval(tick);stopBreathLoop();clearTimeout(attentionTick);if(session)clearTimeout(session.checkDeadline);presenceCard.classList.remove('show');session=null;orb.className='orb';pauseBtn.textContent='Pause'}
function completePractice(){if(completionLocked||!session)return;completionLocked=true;playSound('complete');haptic([50,60,80]);UI.a11y.textContent='Practice complete';celebrateBuddy();setTimeout(petCompletionSignal,850);const done={...session};clearInterval(tick);stopBreathLoop();clearTimeout(attentionTick);session=null;setTimeout(()=>{checkModal.classList.add('show');checkModal.dataset.claimed='0';checkModal.dataset.done=JSON.stringify(done)},1250)}
function finishCheck(feeling){
 if(checkModal.dataset.claimed==='1')return;checkModal.dataset.claimed='1';const s=JSON.parse(checkModal.dataset.done);checkModal.classList.remove('show');checkDaily();
 const actual=s.planned-s.remaining;const presence=s.presenceScore||100;let reward=Math.max(20,Math.round(actual/15));if(presence<60)reward=Math.max(20,Math.round(reward*.5));
 let specialMessage='';
 if(actual>=900){reward+=40;specialMessage=unlockSpecial(2,'Super Calm Treasure');}
 else if(actual>=600){reward+=20;specialMessage=unlockSpecial(1,'Calm Treasure');}
 const capLeft=Math.max(0,220-state.daily.earned);reward=Math.min(reward,capLeft);state.daily.earned+=reward;state.daily.missionCount++;
 if(state.daily.missionCount===3){state.player.coins+=30;toast('Daily mission complete! Bonus 30 coins.');}
 state.player.coins+=reward;state.player.stars+=actual>=600?3:1;state.progress.sessions++;state.progress[s.type]++;state.progress.totalSeconds+=actual;state.progress.checkIns.push({feeling,type:s.type,seconds:actual,at:new Date().toISOString(),hiddenPauses:s.hiddenPauses,attentionPassed:s.attentionPassed,attentionMissed:s.attentionMissed,presenceScore:s.presenceScore||100,visibleSeconds:s.visibleSeconds});updateStreak();
 const p=activePet();p.lastCareAt=Date.now();p.lastDecayAt=Date.now();p.friendXP+=Math.round(actual/20);levelPet(p);save();render();showView('home');
 playSound(specialMessage?'treasure':'coin');toast(`Earned ${reward} coins and ${actual>=600?3:1} star${actual>=600?'s':''}!`);if(specialMessage)setTimeout(()=>toast(specialMessage),500);rewardChoiceText.textContent=`You earned ${reward} coins. Save toward Charlie, or use some coins to care for your pet?`;setTimeout(()=>rewardChoiceModal.classList.add('show'),900)
}
function unlockSpecial(count,label){
 const pool=ITEMS.filter(i=>i.cat==='special'&&!state.ownedItems.includes(i.id));
 const won=pool.slice(0,count);won.forEach(i=>state.ownedItems.push(i.id));
 if(won.length)return `${label} unlocked: ${won.map(i=>i.icon+' '+i.name).join(' and ')}`;
 state.player.coins+=count*50;return `${label}: collection complete, so you received ${count*50} bonus coins!`;
}
function chooseAfterReward(choice){rewardChoiceModal.classList.remove('show');if(choice==='food'){marketCat='food';showView('market');renderMarket();toast('Choose food thoughtfully. You can save the rest for Charlie.')}else{showView('home');if(choice==='save')toast('Great saving choice! Every practice brings Charlie closer.')}}
function updateStreak(){const today=localDate(),last=state.player.lastPracticeDate;if(!last)state.player.streak=1;else{const d=dayDiff(last,today);if(d===1)state.player.streak++;else if(d>1)state.player.streak=1}state.player.lastPracticeDate=today;state.player.bestStreak=Math.max(state.player.bestStreak,state.player.streak)}
document.addEventListener('visibilitychange',()=>{if(!session)return;if(document.hidden&&session.running){session.hiddenPauses++;focusBanner.classList.add('show');setSessionRunning(false)}else if(!document.hidden&&!session.running){session.last=Date.now();toast('Practice is paused. Tap the ▶ Resume button to continue.')}});
function renderParentLog(){const rows=[...state.progress.checkIns].slice(-8).reverse();parentLog.innerHTML=rows.length?rows.map(r=>{const d=new Date(r.at);return `<div class="row"><span><b>${r.type}</b><br>${Math.round(r.seconds/60)} min • ${d.toLocaleDateString()}</span><span>${r.presenceScore??'—'}% presence<br>${r.attentionPassed||0} checks • ${r.hiddenPauses||0} exits</span></div>`}).join(''):'No completed practices yet.'}
function saveSettings(){state.player.name=childName.value.trim()||'Explorer';state.player.age=ageGroup.value;state.settings.sound=soundToggle.checked;state.settings.reducedMotion=motionToggle.checked;state.settings.buddy=buddyToggle.checked;state.settings.petSignal=petSignalToggle.checked;state.settings.haptic=hapticToggle.checked;save();render();toast('Settings saved.')}
function exportData(){const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='mindful-pets-backup.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function validateBackup(x){if(!x||typeof x!=='object'||x.version!==3||!x.player||!Number.isFinite(x.player.coins)||x.player.coins<0||!Number.isFinite(x.player.stars)||x.player.stars<0||!PETS.some(p=>p.id===x.activePetId)||!x.pets||!x.pets[x.activePetId]||!x.inventory||!x.progress||!Array.isArray(x.progress.checkIns)||!Array.isArray(x.ownedItems)||!x.settings||!x.daily)return false;for(const [id,n] of Object.entries(x.inventory))if(!ITEMS.some(i=>i.id===id&&i.cat==='food')||!Number.isInteger(n)||n<0||n>999)return false;for(const [id,p] of Object.entries(x.pets)){if(!PETS.some(q=>q.id===id)||!p||![p.health,p.happiness,p.friendXP,p.level].every(Number.isFinite))return false;p.health=clamp(p.health);p.happiness=clamp(p.happiness)}x.player.name=String(x.player.name||'Explorer').replace(/[<>]/g,'').slice(0,18);x.ownedItems=x.ownedItems.filter(id=>ITEMS.some(i=>i.id===id));x.progress.checkIns=x.progress.checkIns.slice(-500);return true}
function importData(e){const f=e.target.files[0];if(!f)return;if(f.size>500000){e.target.value='';return toast('Backup is too large.')}const r=new FileReader();r.onload=()=>{try{const x=JSON.parse(r.result);if(!validateBackup(x))throw Error();state=x;save();render();toast('Backup restored.')}catch{toast('That backup is not valid.')}finally{e.target.value=''}};r.readAsText(f)}
async function hashPin(pin){const data=new TextEncoder().encode('mindful-pets:'+pin);const hash=await crypto.subtle.digest('SHA-256',data);return [...new Uint8Array(hash)].map(b=>b.toString(16).padStart(2,'0')).join('')}
function openPinSetup(nextAction='setup'){pendingProtectedAction=nextAction;pinTitle.textContent=state.settings.pinHash?'Change parent PIN':'Create parent PIN';pinText.textContent='Enter a new four-digit PIN.';pinInput.value='';pinModal.classList.add('show');setTimeout(()=>pinInput.focus(),50)}
function requestProtectedAction(action){pendingProtectedAction=action;if(!state.settings.pinHash)return openPinSetup(action);pinTitle.textContent='Parent PIN';pinText.textContent='Enter the four-digit parent PIN.';pinInput.value='';pinModal.classList.add('show');setTimeout(()=>pinInput.focus(),50)}
async function submitPin(){const pin=pinInput.value;if(!/^\d{4}$/.test(pin))return toast('Enter exactly four digits.');const h=await hashPin(pin);if(!state.settings.pinHash||pinTitle.textContent.includes('Create')||pinTitle.textContent.includes('Change')){state.settings.pinHash=h;save();const action=pendingProtectedAction;closeModal('pinModal');toast('Parent PIN saved.');if(action==='reset')setTimeout(()=>requestProtectedAction('reset'),250);return}if(h!==state.settings.pinHash)return toast('Incorrect PIN.');const action=pendingProtectedAction;closeModal('pinModal');if(action==='reset')parentReset()}
function parentReset(){state=defaults();save();render();showView('home');toast('Progress reset. Set a new parent PIN when ready.')}
function renderWeeklySummary(){const now=Date.now(),week=state.progress.checkIns.filter(r=>now-new Date(r.at).getTime()<7*86400000),mins=Math.round(week.reduce((a,r)=>a+(Number(r.seconds)||0),0)/60),avg=week.length?Math.round(week.reduce((a,r)=>a+(Number(r.presenceScore)||0),0)/week.length):0;document.getElementById('weeklySummary').innerHTML=`<div class="weekly-stat"><b>${week.length}</b><br><span class="small">Practices</span></div><div class="weekly-stat"><b>${mins}</b><br><span class="small">Mindful minutes</span></div><div class="weekly-stat"><b>${avg}%</b><br><span class="small">Average presence</span></div><div class="weekly-stat"><b>${week.filter(r=>r.type==='breathing').length}</b><br><span class="small">Breathing sessions</span></div>`}
function closeModal(id){document.getElementById(id).classList.remove('show')}
document.querySelectorAll('.modal').forEach(m=>{m.setAttribute('role','dialog');m.setAttribute('aria-modal','true');new MutationObserver(()=>{if(m.classList.contains('show'))setTimeout(()=>m.querySelector('button,input,select,[tabindex]')?.focus(),30)}).observe(m,{attributes:true,attributeFilter:['class']});m.addEventListener('keydown',e=>{if(e.key==='Escape'){m.classList.remove('show');return}if(e.key!=='Tab')return;const f=[...m.querySelectorAll('button:not([disabled]),input:not([disabled]),select:not([disabled]),[tabindex="0"]')];if(!f.length)return;const first=f[0],last=f[f.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}})});document.querySelectorAll('button').forEach(b=>{if(!b.getAttribute('aria-label'))b.setAttribute('aria-label',b.textContent.trim().replace(/\s+/g,' '))});
function format(s){return `${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`}
render();
</script></body></html>
